+def build_app(app, jars, log):
+    """Build the candidate project offline as the unprivileged RUN_AS user, in a private copy of
+    /app and a private HOME + Maven repository copy that this user owns. The build gets a clean
+    environment (no TESTS_DIR/OMS_RUN), cannot read the root-private verifier copy and cannot
+    write /logs/verifier. Only the two regular-file jars are copied out. Returns 0 on success."""
+    build = tempfile.mkdtemp(prefix="oms-build-")
+    home = tempfile.mkdtemp(prefix="oms-home-")
+    try:
+        shutil.copytree(app, build, symlinks=True, dirs_exist_ok=True)
+        for d in os.listdir(build):
+            shutil.rmtree(os.path.join(build, d, "target"), ignore_errors=True)
+        repo = os.path.join(home, "repository")
+        shutil.copytree(os.environ.get("M2_REPO", os.path.expanduser("~/.m2/repository")), repo, symlinks=True)
+        if RUN_AS:
+            subprocess.run(["chown", "-R", RUN_AS, build, home], check=True)
+        env = {"PATH": os.environ.get("PATH", "/usr/bin:/bin"), "HOME": home, "LANG": "C.UTF-8"}
+        if os.environ.get("JAVA_HOME"):
+            env["JAVA_HOME"] = os.environ["JAVA_HOME"]
+        runner = ["runuser", "-u", RUN_AS, "--"] if RUN_AS else []
+        cmd = runner + [shutil.which("mvn") or "mvn", "-o", "-q", "-B", "-Dmaven.repo.local=" + repo,
+                        "package", "-DskipTests"]
+        with open(log, "w") as lg:
+            try:
+                rc = subprocess.run(cmd, cwd=build, env=env, stdout=lg, stderr=subprocess.STDOUT,
+                                    timeout=900).returncode
+            except subprocess.TimeoutExpired:
+                rc = 124
+        if rc != 0:
+            return 1
+        os.makedirs(jars, exist_ok=True)
+        for s in ("order", "item"):
+            src = os.path.join(build, s + "-service", "target", s + "-service.jar")
+            if os.path.islink(src) or not os.path.isfile(src):
+                return 1
+            dst = os.path.join(jars, s + "-service.jar")
+            shutil.copyfile(src, dst)
+            os.chmod(dst, 0o644)
+        os.chmod(jars, 0o755)
+        return 0
+    except Exception as e:
+        print("build error:", repr(e))
+        return 1
+    finally:
+        shutil.rmtree(build, ignore_errors=True)
+        shutil.rmtree(home, ignore_errors=True)
+
+
+if __name__ == "__main__" and sys.argv[1:2] == ["build"]:
+    sys.exit(build_app(*sys.argv[2:5]))
